{
  "name": "yggltree-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "The Yggltree desktop app: a window and a menu bar leaf for the family computer.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac --config electron-builder.yml",
    "dist:x64": "node scripts/stage.mjs --arch x64 && electron-builder --mac --x64",
    "dist:arm64": "node scripts/stage.mjs --arch arm64 && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  }
}
